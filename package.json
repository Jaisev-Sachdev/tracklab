{
  "name": "tracklab",
  "version": "0.1.0",
  "private": true,
  "description": "Film a physics experiment; SAM 3.1 tracks it and a Muse Spark agent runs the analysis.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "spike:clips": "tsx scripts/spike/make-clips.ts",
    "spike:sam": "tsx --env-file-if-exists=.env.local scripts/spike/sam.ts",
    "spike:spark": "tsx --env-file-if-exists=.env.local scripts/spike/spark.ts",
    "spike:sam-image": "tsx --env-file-if-exists=.env.local scripts/spike/sam-image.ts",
    "spike:masks": "tsx scripts/spike/masks.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "ffmpeg-static": "5.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  }
}
