{
  "name": "tracklab",
  "version": "0.1.0",
  "private": true,
  "description": "Film a physics experiment; SAM 3.1 tracks it and a Muse Spark agent runs the analysis.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "spike:clips": "tsx scripts/spike/make-clips.ts",
    "spike:sam": "tsx --env-file-if-exists=.env.local scripts/spike/sam.ts",
    "spike:spark": "tsx --env-file-if-exists=.env.local scripts/spike/spark.ts",
    "spike:sam-image": "tsx --env-file-if-exists=.env.local scripts/spike/sam-image.ts",
    "spike:masks": "tsx scripts/spike/masks.ts",
    "cache:sample": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/cache-sample.ts",
    "bench:render": "tsx scripts/bench/render.ts",
    "bench:run": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/bench/run.ts",
    "analyse:cached": "tsx --conditions=react-server scripts/analyse-cached.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@meta-sam/graphics": "0.1.13",
    "@meta-sam/parser": "0.1.0",
    "@meta-sam/react": "0.1.14",
    "@meta-sam/video": "0.1.5",
    "@vercel/blob": "2.8.2",
    "mediabunny": "1.55.7",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  }
}
