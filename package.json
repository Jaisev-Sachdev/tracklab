{
  "name": "tracklab",
  "version": "0.1.0",
  "private": true,
  "description": "Film a physics experiment; SAM 3.1 tracks it and a Muse Spark agent runs the analysis.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "spike:clips": "tsx scripts/spike/make-clips.ts",
    "spike:sam": "tsx --env-file-if-exists=.env.local scripts/spike/sam.ts",
    "spike:spark": "tsx --env-file-if-exists=.env.local scripts/spike/spark.ts",
    "spike:sam-image": "tsx --env-file-if-exists=.env.local scripts/spike/sam-image.ts",
    "spike:masks": "tsx scripts/spike/masks.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ffmpeg-static": "5.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0"
  }
}
